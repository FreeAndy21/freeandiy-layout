<?xml version="1.0" encoding="utf-8"?>
<!--
  FreeANDIY Layout MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build designcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.pcraft` owned by FreeANDIY Layout,
  and FreeANDIY Layout offered under "Open with" for PSD/PSB and the image formats it reads (without
  taking over the user's default app for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="FreeANDIY Layout"
      Manufacturer="Free Andy Agency"
      Version="$(var.Version)"
      UpgradeCode="0A5E2249-5BCF-4414-BF66-D5085456AC3A"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="FreeANDIY Layout page layout and publishing" Manufacturer="Free Andy Agency" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of FreeANDIY Layout is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DesigncraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DesigncraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://freeandiy.freeandy.agency/layout" />
    <Property Id="ARPURLUPDATEINFO" Value="https://freeandiy.freeandy.agency/layout" />
    <Property Id="ARPHELPLINK" Value="https://github.com/FreeAndy21/freeandiy-layout/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FreeANDIY Layout" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="FreeANDIY Layout" Level="1">
      <ComponentGroupRef Id="DesigncraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DesigncraftFiles" Directory="INSTALLFOLDER">
      <Component Id="DesigncraftApp" Guid="A5EA00DF-8842-421C-93F4-D71E210B95F7">
        <File Id="DesigncraftExe" Source="$(var.BinDir)\freeandiy-layout.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FreeANDIY Layout"
              Description="FreeANDIY Layout page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="DesigncraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\freeandiy-layout.exe" Value="[#DesigncraftExe]" Type="string" />
      </Component>

      <Component Id="DesigncraftCli">
        <File Id="DesigncraftCliExe" Source="$(var.BinDir)\freeandiy-layout-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
