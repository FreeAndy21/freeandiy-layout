<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>agency.freeandy.layout</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>FreeANDIY Layout</name>
  <summary>Lay out magazines, books and print documents</summary>
  <developer id="agency.freeandy">
    <name>Free Andy Agency</name>
  </developer>
  <description>
    <p>
      FreeANDIY Layout is a page layout. Lay out magazines, books and print documents
    </p>
  </description>
  <launchable type="desktop-id">agency.freeandy.layout.desktop</launchable>
  <icon type="stock">agency.freeandy.layout</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://freeandiy.freeandy.agency/layout</url>
  <url type="bugtracker">https://github.com/FreeAndy21/freeandiy-layout/issues</url>
  <url type="help">https://github.com/FreeAndy21/freeandiy-layout</url>
  <url type="contact">https://github.com/FreeAndy21/freeandiy-layout/issues</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Editing The Great Wave off Kanagawa with type layers and adjustment layers</caption>
      <image>https://raw.githubusercontent.com/FreeAndy21/freeandiy-layout/main/docs/images/freeandiy-layout-demo.jpg</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>freeandiy-layout</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
